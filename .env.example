# Database (required)
DATABASE_URL=

# Auth
JWT_SECRET=

# Guest demo login (server-only — set in .env, never commit .env)
GUEST_NAME=Guest

# Cloudinary (server-only for signed uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI / Groq (Llama) rate limits — optional; defaults shown
GROQ_API_KEY=
# Per-user/IP cap on AI generate routes (workout, nutrition, progress)
AI_ROUTE_RATE_LIMIT_MAX=10
AI_ROUTE_RATE_LIMIT_WINDOW_MS=60000
# Outbound Groq API protection (per server instance)
GROQ_RATE_LIMIT_MAX=10
GROQ_RATE_LIMIT_WINDOW_MS=60000
GROQ_RATE_LIMIT_CONCURRENT=2

# Set API_DEBUG=1 locally to include error details in AI 500 responses
API_DEBUG=
