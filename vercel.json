{
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_API_URL": "https://${VERCEL_URL}",
    "JWT_SECRET": "quantumfit-jwt-secret-key",
    "SESSION_SECRET": "quantumfit-super-secret-key"
  }
}
